# ============================================================================
# PUBLIC REPO — keep architecture, schema, endpoints, secrets, and session OUT.
# When adding a new file, ask: does it reveal internal hosts/schema/auth? If yes,
# it belongs in a gitignored path below. Verify with:  git status  before commit.
# ============================================================================

# --- Dependencies ---
node_modules/

# --- Secrets & credentials (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
wallet/
tnsnames.ora
sqlnet.ora

# --- Authenticated session / cookies (crown jewels) ---
user-data/

# --- Scraped data & local runtime state ---
downloads/
recon/
state/
logs/
*.log

# --- Sensitive local docs: architecture, schema, internal endpoints ---
# (kept LOCAL only; hand-applied on the target PC)
plans/
db/
AI_LOCAL_NOTES.md
LOCAL_SETUP.md

# --- Dev/probe scripts that embed raw endpoint details (keep local) ---
check.mjs
map.mjs
scrape.mjs
get-report.mjs
fetch-stealth.mjs
inspect-stream.mjs

# --- OS / editor cruft ---
.DS_Store
.idea/
.vscode/
