# Copy to `.env` and fill with REAL values (see LOCAL_SETUP.md, kept local).
# `.env` is gitignored and must NEVER be committed.

# --- Sources to scrape UNATTENDED (comma-separated; adapters live in sources/) ---
# gs/jpm/citi persist via cookies (one-time recon login). barc has no persistent session but
# runs unattended via scripted login when BARC_USER/BARC_PASS are set (else use --login).
SOURCES=gs,jpm,citi,barc

# --- Goldman Sachs (source key: gs; real hosts masked in this public repo) ---
# TARGET_* are the original names and still work; GS_* take precedence if set.
TARGET_ORIGIN=https://REDACTED.example.com
TARGET_HOMEPAGE=https://REDACTED.example.com/REDACTED/homepage.html
TARGET_MYCONTENT=https://REDACTED.example.com/REDACTED/my-content
TARGET_FEED_BASE=https://REDACTED.example.com/REDACTED/feed
TARGET_REPORT_PREFIX=/REDACTED/reports

# --- Additional portals (real hosts in your LOCAL .env only; keep placeholders here) ---
# J.P. Morgan (key: jpm) - cookie session; unattended after a one-time `python recon.py <jpm-url>`.
# JPM_ORIGIN=https://REDACTED.example.com
# Citi (key: citi) - cookie session; unattended after a one-time recon login.
# CITI_ORIGIN=https://REDACTED.example.com
# Morgan Stanley (key: ms) - cookie session; text from the article 'sections' API + the
# official PDF (via frontmatter's pdfRenditionUrl). Unattended after a one-time recon login.
# MS_ORIGIN=https://REDACTED.example.com
# Deutsche Bank (key: db) - IHS Markit white-label; feed = parsed homepage 'featured' cards,
# PDF via a validate->namedFileProxy token flow, text from the PDF. One-time email-verified
# login then persists via cookie -> unattended. DB_CLIENT defaults to the site id.
# DB_ORIGIN=https://REDACTED.example.com
# DB_CLIENT=2795
# Barclays (key: barc) - session does NOT persist across launches. Two ways to run it:
#   interactive:  python daily.py --source barc --login   (log in in the window that opens)
#   unattended:   set BARC_USER + BARC_PASS below -> scripted PingFederate login each run.
# BARC_PRODUCT_GROUPS = your account's research-grid product-group ids (comma-separated).
# BARC_ORIGIN=https://REDACTED.example.com
# BARC_PRODUCT_GROUPS=
# BARC_USER=
# BARC_PASS=
# Morgan Stanley (key: ms) and HSBC (key: hsbc): no adapter yet (discovery not done).

# --- OracleDB ---
DB_USER=
DB_PASSWORD=
DB_CONNECT_STRING=host:port/service_name
# TNS_ADMIN=/path/to/wallet     # only if using a wallet / TCPS

# --- AI endpoint (OpenAI-compatible chat) ---
LLM_API_URL=
LLM_API_KEY=
# LLM_MODEL=                    # leave unset for the GGUF backend
# LLM_CA_BUNDLE=/path/to/ca.pem

# --- Daily email: sent via local Outlook (pywin32 COM), no SMTP ---
# AI curation of which reports go in the email (edit prompts/curate.system.txt for
# your include/exclude topics). Set to 0/false to email every report instead.
CURATE_EMAIL=1
MAIL_TO=you@example.com,friend1@example.com
MAIL_CC=
MAIL_FROM=      # optional: a shared mailbox to send on behalf of (else your default account)

# --- Web app links in emails ---
WEBAPP_BASE_URL=https://REDACTED.internal.example.com
