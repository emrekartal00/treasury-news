# ============================================================================
# PUBLIC REPO — keep architecture, schema, endpoints, secrets, session, data OUT.
# When adding a file, ask: does it reveal internal hosts/schema/auth? If yes, it belongs
# in a gitignored path below. Verify with:  git status  before every commit.
# ============================================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# --- Legacy Node (project ported to Python) ---
node_modules/
*.mjs
package.json
package-lock.json

# --- Secrets & credentials (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
wallet/
tnsnames.ora
sqlnet.ora

# --- Authenticated session / cookies (crown jewels) ---
user-data/

# --- Scraped data & local runtime state ---
downloads/
recon/
state/
logs/
*.log

# --- Sensitive local docs: schema, architecture, internal endpoints ---
plans/
# ignore all of db/ (migrations DDL, discover.sql) EXCEPT the smoke test.
# NOTE: gitignore has no inline comments — keep these patterns on their own lines.
db/*
!db/smoke_test.py
AI_LOCAL_NOTES.md
LOCAL_SETUP.md

# --- OS / editor cruft ---
.DS_Store
.idea/
.vscode/

# OpenShift secrets (real values)
secret.yaml
**/secret.yaml
